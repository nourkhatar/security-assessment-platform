{
  "title": "Docker Lab Monitoring",
  "uid": "lab-monitoring",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (%) per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "docker_container_cpu_percent{name=~\"lab-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage (MB) per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "docker_container_memory_usage_bytes{name=~\"lab-.*\"} / 1024 / 1024",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory Usage (% of limit)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "docker_container_memory_percent{name=~\"lab-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container Running State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "docker_container_running{name=~\"lab-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s"
}
